{
  "name": "@classytic/mongokit",
  "version": "3.46.0",
  "description": "Production-grade MongoDB repositories - smart pagination, events, and plugins. Built on @classytic/repo-core.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./pagination": {
      "types": "./dist/pagination/PaginationEngine.d.mts",
      "default": "./dist/pagination/PaginationEngine.mjs"
    },
    "./pagination/limits": {
      "types": "./dist/pagination/utils/limits.d.mts",
      "default": "./dist/pagination/utils/limits.mjs"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.mts",
      "default": "./dist/plugins/index.mjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.mts",
      "default": "./dist/utils/index.mjs"
    },
    "./actions": {
      "types": "./dist/actions/index.d.mts",
      "default": "./dist/actions/index.mjs"
    },
    "./ai": {
      "types": "./dist/ai/index.d.mts",
      "default": "./dist/ai/index.mjs"
    },
    "./adapter": {
      "types": "./dist/adapter/index.d.mts",
      "default": "./dist/adapter/index.mjs"
    },
    "./better-auth": {
      "types": "./dist/better-auth/index.d.mts",
      "default": "./dist/better-auth/index.mjs"
    },
    "./outbox": {
      "types": "./dist/outbox/index.d.mts",
      "default": "./dist/outbox/index.mjs"
    },
    "./idempotency": {
      "types": "./dist/idempotency/index.d.mts",
      "default": "./dist/idempotency/index.mjs"
    },
    "./sync": {
      "types": "./dist/sync/index.d.mts",
      "default": "./dist/sync/index.mjs"
    },
    "./lock": {
      "types": "./dist/lock/index.d.mts",
      "default": "./dist/lock/index.mjs"
    },
    "./usage": {
      "types": "./dist/usage/index.d.mts",
      "default": "./dist/usage/index.mjs"
    },
    "./query/primitives/geo": {
      "types": "./dist/query/primitives/geo.d.mts",
      "default": "./dist/query/primitives/geo.mjs"
    },
    "./query/primitives/coercion": {
      "types": "./dist/query/primitives/coercion.d.mts",
      "default": "./dist/query/primitives/coercion.mjs"
    },
    "./query/primitives/indexes": {
      "types": "./dist/query/primitives/indexes.d.mts",
      "default": "./dist/query/primitives/indexes.mjs"
    },
    "./indexes": {
      "types": "./dist/indexes/verify-indexes.d.mts",
      "default": "./dist/indexes/verify-indexes.mjs"
    },
    "./tenant": {
      "types": "./dist/tenant/index.d.mts",
      "default": "./dist/tenant/index.mjs"
    },
    "./testkit": {
      "types": "./dist/testkit/index.d.mts",
      "default": "./dist/testkit/index.mjs"
    },
    "./read-model": {
      "types": "./dist/read-model/index.d.mts",
      "default": "./dist/read-model/index.mjs"
    },
    "./kernel-conformance": {
      "types": "./dist/kernel-conformance/index.d.mts",
      "default": "./dist/kernel-conformance/index.mjs"
    },
    "./search": {
      "types": "./dist/search/index.d.mts",
      "default": "./dist/search/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "TRADEMARK.md",
    "llms.txt",
    "skills/**/*.md"
  ],
  "keywords": [
    "mongodb",
    "mongoose",
    "repository",
    "repository-pattern",
    "data-access",
    "pagination",
    "cursor-pagination",
    "infinite-scroll",
    "offset-pagination",
    "keyset-pagination",
    "caching",
    "redis",
    "cache",
    "multi-tenant",
    "multi-tenancy",
    "vector-search",
    "embeddings",
    "atlas-search",
    "observability",
    "event-driven",
    "plugin-based",
    "zero-dependencies",
    "express",
    "fastify",
    "nestjs",
    "nextjs",
    "typescript"
  ],
  "author": "Classytic <classytic.dev@gmail.com> (https://github.com/classytic)",
  "contributors": [
    "Sadman Chowdhury (https://github.com/siam923)"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/classytic/mongokit.git"
  },
  "bugs": {
    "url": "https://github.com/classytic/mongokit/issues"
  },
  "homepage": "https://github.com/classytic/mongokit#readme",
  "peerDependencies": {
    "@classytic/repo-core": ">=0.38.0",
    "mongodb-memory-server": ">=11.3.0",
    "mongoose": ">=9.12.0"
  },
  "peerDependenciesMeta": {
    "mongodb-memory-server": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:all": "vitest run --project unit --project integration --project e2e",
    "test:watch": "vitest --project unit --project integration",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "lint": "biome check src/",
    "lint:fix": "biome check src/ --write",
    "check:exports": "node scripts/check-exports.mjs",
    "lint:package": "npm run check:exports && publint && attw --pack . --profile esm-only",
    "format": "biome format src/ --write",
    "check": "biome ci src/ --diagnostic-level=error",
    "check:dead-code": "knip",
    "check:peer-skew": "node scripts/check-peer-skew.mjs",
    "ci": "npm run check:peer-skew && npm run check && npm run typecheck && npm run typecheck:tests && npm run build && npm run lint:package && npm run check:dead-code && npm run check:forgotten-exports && npm run check:skills && npm test",
    "push": "classytic-push",
    "prepublishOnly": "npm run ci",
    "publish:dry": "npm publish --dry-run --access public",
    "publish:npm": "npm publish --access public",
    "release:tag": "node -e \"require('child_process').execSync('npm run push -- v'+require('./package.json').version,{stdio:'inherit'})\"",
    "release": "npm run push -- main && npm run release:tag && npm publish --access public",
    "release:patch": "npm version patch && npm run release",
    "release:minor": "npm version minor && npm run release",
    "release:major": "npm version major && npm run release",
    "check:forgotten-exports": "node scripts/check-forgotten-exports.mjs",
    "check:skills": "node scripts/check-skills.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@better-auth/api-key": "^1.7.18",
    "@better-auth/mongo-adapter": "^1.7.18",
    "@biomejs/biome": "^2.6.5",
    "@classytic/dev-tools": "^0.2.1",
    "@classytic/repo-core": "^0.38.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-auth": "^1.7.18",
    "dotenv": "^18.0.9",
    "fast-check": "^4.10.2",
    "knip": "^6.44.1",
    "mongodb": "~7.8.0",
    "mongodb-memory-server": "^11.3.0",
    "mongoose": "^9.12.0",
    "publint": "^0.3.25",
    "ts-api": "npm:typescript@~5.9.3",
    "tsdown": "^0.23.5",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  }
}
